<footer style="background-color: #f8f9fa; border-top: 1px solid #e0e0e0; padding: 1.5rem 0; margin-top: auto; width: 100%;">
  <div class="f-info" style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.75rem; text-align: center; color: #222222; font-family: inherit;">
    
    <!-- Social Icons -->
    <div class="f-info-socials" style="display: flex; gap: 1.25rem;">
      <a href="https://facebook.com" target="_blank" aria-label="Facebook" style="color: #222222; font-size: 1.4rem; text-decoration: none;">
        <i class="fa-brands fa-square-facebook"></i>
      </a>
      <a href="https://instagram.com" target="_blank" aria-label="Instagram" style="color: #222222; font-size: 1.4rem; text-decoration: none;">
        <i class="fa-brands fa-square-instagram"></i>
      </a>
      <a href="https://linkedin.com" target="_blank" aria-label="LinkedIn" style="color: #222222; font-size: 1.4rem; text-decoration: none;">
        <i class="fa-brands fa-linkedin"></i>
      </a>
    </div>
    
    <!-- Brand Name -->
    <div class="f-info-brand" style="font-size: 0.9rem; color: #6a6a6a; font-weight: 500;">
      &copy; <%= typeof brandName !== 'undefined' ? brandName : 'WanderLust Private Limited' %>
    </div>
    
    <!-- Links -->
    <div class="f-info-links" style="display: flex; gap: 1.5rem;">
      <a href="/privacy" style="color: #222222; text-decoration: none; font-size: 0.9rem; font-weight: 500;">Privacy</a>
      <a href="/terms" style="color: #222222; text-decoration: none; font-size: 0.9rem; font-weight: 500;">Terms</a>
    </div>

  </div>
</footer>