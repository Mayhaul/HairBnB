<%- layout("/layouts/boilerplate") %>

<!-- Flash Alerts Container -->
<div class="container mt-3" style="max-width: 480px;">
  <% if (typeof error !== 'undefined' && error.length) { %>
    <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm" role="alert">
      <%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <% if (typeof success !== 'undefined' && success.length) { %>
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm" role="alert">
      <%= success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>
</div>

<style>
  .auth-container {
    max-width: 460px;
    margin: 3rem auto;
  }

  .auth-card {
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid #eaeaea;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
    padding: 2.5rem;
  }

  .auth-brand-icon {
    font-size: 2.5rem;
    color: #fe424d;
  }

  .auth-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: #1a1a1a;
  }

  .form-control-custom {
    border-radius: 10px;
    padding: 0.75rem 1rem;
    border: 1px solid #ced4da;
    font-size: 0.95rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .form-control-custom:focus {
    border-color: #fe424d;
    box-shadow: 0 0 0 0.2rem rgba(254, 66, 77, 0.15);
  }

  .btn-auth-submit {
    background-color: #fe424d;
    color: #ffffff;
    font-weight: 600;
    padding: 0.75rem;
    border-radius: 10px;
    border: none;
    width: 100%;
    transition: background-color 0.2s ease, transform 0.1s ease;
  }

  .btn-auth-submit:hover {
    background-color: #e0323d;
    color: #ffffff;
    transform: translateY(-1px);
  }
</style>

<div class="container auth-container">
  <div class="auth-card">
    
    <!-- Header -->
    <div class="text-center mb-4">
      <i class="fa-solid fa-compass auth-brand-icon mb-2"></i>
      <h2 class="auth-title">Join HairBnB</h2>
      <p class="text-muted fs-6">Create an account to host or explore stays</p>
    </div>

    <!-- Signup Form -->
    <form action="/signup" method="POST" class="needs-validation" novalidate>
      
      <!-- Username Field -->
      <div class="mb-3">
        <label for="username" class="form-label fw-semibold text-secondary">Username</label>
        <input 
          type="text" 
          name="username" 
          id="username" 
          class="form-control form-control-custom" 
          placeholder="Choose a username" 
          required 
          autofocus
        />
        <div class="valid-feedback">Looks good!</div>
        <div class="invalid-feedback">Please choose a username.</div>
      </div>

      <!-- Email Field -->
      <div class="mb-3">
        <label for="email" class="form-label fw-semibold text-secondary">Email Address</label>
        <input 
          type="email" 
          name="email" 
          id="email" 
          class="form-control form-control-custom" 
          placeholder="Enter your email" 
          required 
        />
        <div class="valid-feedback">Looks good!</div>
        <div class="invalid-feedback">Please provide a valid email.</div>
      </div>

      <!-- Password Field -->
      <div class="mb-4">
        <label for="password" class="form-label fw-semibold text-secondary">Password</label>
        <input 
          type="password" 
          name="password" 
          id="password" 
          class="form-control form-control-custom" 
          placeholder="Create a password" 
          required 
        />
        <div class="valid-feedback">Looks good!</div>
        <div class="invalid-feedback">Please enter a password.</div>
      </div>

      <!-- Submit Button -->
      <button type="submit" class="btn btn-auth-submit mb-3">
        Create Account
      </button>

      <!-- Footer Link -->
      <div class="text-center mt-3">
        <span class="text-muted">Already have an account?</span>
        <a href="/login" class="fw-semibold text-decoration-none" style="color: #fe424d;">Log in here</a>
      </div>

    </form>

  </div>
</div>