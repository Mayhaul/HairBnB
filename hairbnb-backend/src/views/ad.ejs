<%- layout("/layouts/boilerplate") %>

<style>
  /* Page Container Layout */
  .ad-show-container {
    max-width: 600px;
    margin: 2rem auto;
  }

  /* Card Container */
  .ad-card {
    background: #ffffff;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .ad-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
  }

  /* Image Styling */
  .ad-image-container {
    width: 100%;
    height: 300px;
    background-color: #e9ecef;
    overflow: hidden;
  }

  .ad-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Content Section */
  .ad-content {
    padding: 24px;
  }

  .ad-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 8px;
  }

  .ad-price {
    font-size: 1.25rem;
    font-weight: 700;
    color: #2e7d32; /* Accent green color */
    margin-bottom: 16px;
  }

  .ad-description {
    color: #555;
    margin-bottom: 20px;
    font-size: 1rem;
    line-height: 1.5;
  }

  /* Metadata Section */
  .ad-meta {
    display: flex;
    align-items: center;
    font-size: 0.9rem;
    color: #777;
    border-top: 1px solid #eee;
    padding-top: 16px;
    margin-bottom: 20px;
  }

  .ad-location-icon {
    margin-right: 6px;
  }

  /* Action Buttons Section */
  .action-buttons {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .btn-custom {
    border-radius: 8px;
    padding: 8px 20px;
    font-weight: 600;
    transition: opacity 0.2s ease;
  }

  .btn-custom:hover {
    opacity: 0.9;
  }
</style>

<div class="container ad-show-container">
  
  <!-- Back Button -->
  <a href="/listings" class="btn btn-outline-secondary mb-3 btn-custom">
    &larr; Go Back
  </a>

  <!-- Listing Card -->
  <article class="ad-card">
    <% if (ad.image && ad.image.url) { %>
      <div class="ad-image-container">
        <img class="ad-image" src="<%= ad.image.url %>" alt="<%= ad.title %>">
      </div>
    <% } %>

    <div class="ad-content">
      <h1 class="ad-title"><%= ad.title %></h1>
      <p class="ad-price">&#8377; <%= ad.price.toLocaleString("en-IN") %></p>
      <p class="ad-description"><%= ad.description %></p>

      <div class="ad-meta">
        <span class="ad-location-icon">📍</span>
        <span><%= ad.location %>, <%= ad.country %></span>
      </div>

      <!-- Action Buttons Row -->
      <div class="action-buttons">
        <a href="/listings/<%= ad._id %>/edit" class="btn btn-dark btn-custom">
          Edit Ad
        </a>

        <form action="/listings/<%= ad._id %>/delete" method="POST" class="d-inline">
          <button type="submit" class="btn btn-danger btn-custom">
            Delete
          </button>
        </form>
      </div>

    </div>
  </article>

</div>