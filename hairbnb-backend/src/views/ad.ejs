<%- layout("/layouts/boilerplate") %>

<% if (success && success.length) { %>
  <div class="alert alert-success alert-dismissible fade show flash-alert" role="alert">
    <%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>

  <script>
    setTimeout(() => {
      const alertElem = document.querySelector('.flash-alert');
      if (alertElem) {
        const bsAlert = bootstrap.Alert.getOrCreateInstance(alertElem);
        bsAlert.close();
      }
    }, 3000);
  </script>
<% } %>

<style>
  /* Base Container */
  .ad-show-container {
    max-width: 1100px;
    margin: 2rem auto;
  }

  /* Listing Main Card */
  .ad-card {
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid #eaeaea;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.05);
    overflow: hidden;
  }

  .ad-image-container {
    width: 100%;
    height: 380px;
    background-color: #f1f3f5;
    overflow: hidden;
  }

  .ad-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ad-title {
    font-size: 1.85rem;
    font-weight: 700;
    color: #1a1a1a;
  }

  .ad-price {
    font-size: 1.4rem;
    font-weight: 700;
    color: #fe424d; /* Brand Accent */
  }

  /* Review Section Card */
  .review-card {
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid #eaeaea;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.05);
    padding: 1.5rem;
  }

  /* Star Rating Styles */
  .star-rating {
    display: flex;
    flex-direction: row-reverse;
    justify-content: flex-end;
    gap: 4px;
  }

  .star-rating input {
    display: none;
  }

  .star-rating label {
    font-size: 1.5rem;
    color: #ccc;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .star-rating input:checked ~ label,
  .star-rating label:hover,
  .star-rating label:hover ~ label {
    color: #ffb400;
  }

  /* Review Bubble Badge */
  .review-item {
    border-radius: 12px;
    background-color: #f8f9fa;
    border: 1px solid #eee;
  }
</style>

<div class="container ad-show-container">
  
  <!-- Back Button -->
  <a href="/listings" class="btn btn-outline-secondary mb-3 rounded-pill px-3">
    &larr; Back to Listings
  </a>

  <!-- 2-Column Responsive Grid -->
  <div class="row g-4">
    
    <!-- LEFT COLUMN: Listing Details -->
    <div class="col-lg-7">
      <article class="ad-card">
        <% if (ad.image && ad.image.url) { %>
          <div class="ad-image-container">
            <img class="ad-image" src="<%= ad.image.url %>" alt="<%= ad.title %>">
          </div>
        <% } %>

        <div class="p-4">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h1 class="ad-title mb-0"><%= ad.title %></h1>
            <span class="ad-price">&#8377; <%= ad.price.toLocaleString("en-IN") %> <small class="text-muted fw-normal" style="font-size: 0.9rem;">/ night</small></span>
          </div>

          <p class="text-muted mb-3">
            📍 <%= ad.location %>, <%= ad.country %>
          </p>

          <p class="text-secondary mb-4" style="line-height: 1.6;">
            <%= ad.description %>
          </p>

          <hr class="my-4" style="opacity: 0.1;">

          <!-- Action Buttons -->
          <div class="d-flex justify-content-between align-items-center">
            <a href="/listings/<%= ad._id %>/edit" class="btn btn-dark px-4 rounded-3">
              Edit Listing
            </a>

            <form action="/listings/<%= ad._id %>/delete" method="POST" class="d-inline">
              <button type="submit" class="btn btn-outline-danger px-4 rounded-3">
                Delete Listing
              </button>
            </form>
          </div>
        </div>
      </article>
    </div>

    <!-- RIGHT COLUMN: Reviews & Review Form -->
    <div class="col-lg-5">
      
      <!-- Leave a Review Form -->
      <div class="review-card mb-4">
        <h4 class="fw-bold mb-3">Leave a Review</h4>
        
        <form action="/listings/<%= ad._id %>/reviews" method="POST">
          <!-- Interactive Star Rating -->
          <div class="mb-3">
            <label class="form-label d-block text-muted mb-1">Rating</label>
            <div class="star-rating">
              <input type="radio" id="star5" name="review[rating]" value="5" />
              <label for="star5" title="5 stars">★</label>

              <input type="radio" id="star4" name="review[rating]" value="4" />
              <label for="star4" title="4 stars">★</label>

              <input type="radio" id="star3" name="review[rating]" value="3" />
              <label for="star3" title="3 stars">★</label>

              <input type="radio" id="star2" name="review[rating]" value="2" />
              <label for="star2" title="2 stars">★</label>

              <input type="radio" id="star1" name="review[rating]" value="1" checked />
              <label for="star1" title="1 star">★</label>
            </div>
          </div>

          <div class="mb-3">
            <label for="reviewTextBox" class="form-label text-muted">Comments</label>
            <textarea 
              name="review[comment]" 
              id="reviewTextBox" 
              class="form-control rounded-3" 
              rows="3" 
              placeholder="How was your experience?" 
              required
            ></textarea>
          </div>

          <button type="submit" class="btn btn-danger w-100 rounded-3">Post Review</button>
        </form>
      </div>

      <!-- All Reviews List -->
      <div class="review-card">
        <h4 class="fw-bold mb-3">All Reviews (<%= review ? review.length : 0 %>)</h4>
        
        <% if (review && review.length > 0) { %>
          <div class="d-flex flex-column gap-3">
            <% for (let r of review) { %>
              <div class="review-item p-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <span class="fw-bold text-warning" style="font-size: 1.1rem;">
                    <% for(let i=0; i < r.rating; i++) { %>★<% } %><% for(let i=r.rating; i < 5; i++) { %>☆<% } %>
                  </span>

                  <!-- Delete Review Button -->
                  <form action="/listings/<%= ad._id %>/reviews/<%= r._id %>?_method=DELETE" method="POST" class="d-inline">
                    <button class="btn btn-link text-danger p-0 border-0" type="submit" title="Delete Review">
                      <small>Delete</small>
                    </button>
                  </form>
                </div>
                <p><%= r.user ? r.user.username : 'Anonymous' %></p>
                <p class="mb-0 text-secondary" style="font-size: 0.95rem;"><%= r.comment %></p>
              </div>
            <% } %>
          </div>
        <% } else { %>
          <p class="text-muted mb-0">No reviews yet for this listing.</p>
        <% } %>
      </div>

    </div>

  </div>
</div>