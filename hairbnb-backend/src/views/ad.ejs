<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= ad.title %></title>
    <style>
        /* Modern Reset & Base Styles */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: #f4f6f8;
            color: #333;
            line-height: 1.6;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        /* Card Container */
        .ad-card {
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            max-width: 500px;
            width: 100%;
            overflow: hidden;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .ad-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
        }

        /* Image Styling */
        .ad-image-container {
            width: 100%;
            height: 250px;
            background-color: #e9ecef;
            overflow: hidden;
        }

        .ad-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        /* Content Section */
        .ad-content {
            padding: 24px;
        }

        .ad-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: #1a1a1a;
            margin-bottom: 8px;
        }

        .ad-price {
            font-size: 1.25rem;
            font-weight: 700;
            color: #2e7d32; /* Accent green color */
            margin-bottom: 16px;
        }

        .ad-description {
            color: #555;
            margin-bottom: 20px;
            font-size: 0.95rem;
        }

        /* Footer / Metadata */
        .ad-meta {
            display: flex;
            align-items: center;
            font-size: 0.875rem;
            color: #777;
            border-top: 1px solid #eee;
            padding-top: 16px;
        }

        .ad-location-icon {
            margin-right: 6px;
        }
    </style>
</head>
<body>

    <article class="ad-card">
        <% if (ad.image) { %>
            <div class="ad-image-container">
                <img class="ad-image" src="<%= ad.image.url %>" alt="<%= ad.title %>">
            </div>
        <% } %>

        <div class="ad-content">
            <h1 class="ad-title"><%= ad.title %></h1>
            <p class="ad-price">$<%= ad.price %></p>
            <p class="ad-description"><%= ad.description %></p>
            
            <div class="ad-meta">
                <span class="ad-location-icon">📍</span>
                <span><%= ad.location %>, <%= ad.country %></span>
            </div>
        </div>
    </article>

</body>
</html>