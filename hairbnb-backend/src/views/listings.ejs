<%- layout("/layouts/boilerplate") %>

<% if (success && success.length) { %>
  <div class="alert alert-success alert-dismissible fade show flash-alert" role="alert">
    <%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>

  <script>
    setTimeout(() => {
      const alertElem = document.querySelector('.flash-alert');
      if (alertElem) {
        const bsAlert = bootstrap.Alert.getOrCreateInstance(alertElem);
        bsAlert.close();
      }
    }, 3000);
  </script>
<% } %>

<style>
  /* Section Layout */
  .listings-container {
    max-width: 1200px;
    margin: 2.5rem auto;
  }

  /* Modern Hero / Header Bar */
  .listings-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #eaeaea;
  }

  .page-title {
    font-size: 2.2rem;
    font-weight: 800;
    color: #1a1a1a;
    letter-spacing: -0.5px;
  }

  .page-subtitle {
    color: #6c757d;
    font-size: 0.95rem;
    margin-top: 4px;
  }

  .btn-brand-accent {
    background-color: #fe424d;
    color: #ffffff;
    font-weight: 600;
    border: none;
    border-radius: 10px;
    padding: 10px 22px;
    transition: all 0.2s ease-in-out;
    box-shadow: 0 4px 12px rgba(254, 66, 77, 0.25);
  }

  .btn-brand-accent:hover {
    background-color: #e0323d;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(254, 66, 77, 0.35);
  }

  /* Grid Layout */
  .listings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 28px;
    padding: 0;
    list-style: none;
  }

  /* Card Styling & Hover Effects */
  .listing-card-link {
    text-decoration: none;
    color: inherit;
    display: block;
    height: 100%;
  }

  .listing-card {
    background: #ffffff;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid #eaeaea;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    height: 100%;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .listing-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.1);
  }

  /* Aspect Ratio Fixed Image Box */
  .card-img-container {
    width: 100%;
    height: 220px;
    background-color: #f1f3f5;
    overflow: hidden;
    position: relative;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .listing-card:hover .card-img {
    transform: scale(1.06);
  }

  /* Card Body Content */
  .card-body-content {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    justify-content: space-between;
  }

  .listing-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: #111;
    margin-bottom: 6px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .listing-location {
    font-size: 0.875rem;
    color: #6c757d;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .listing-price {
    font-size: 1.15rem;
    font-weight: 800;
    color: #fe424d;
    margin-bottom: 0;
  }

  .listing-price-unit {
    font-size: 0.85rem;
    font-weight: 400;
    color: #6c757d;
  }

  .listing-action {
    font-size: 0.875rem;
    font-weight: 600;
    color: #111;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: color 0.2s ease;
  }

  .listing-card:hover .listing-action {
    color: #fe424d;
  }

  /* Empty state styling */
  .empty-state {
    text-align: center;
    padding: 80px 20px;
    background: #ffffff;
    border-radius: 16px;
    border: 1px dashed #ced4da;
    color: #6c757d;
  }
</style>

<div class="container listings-container">
  
  <!-- Header Bar -->
  <div class="listings-header">
    <div>
      <h1 class="page-title">Explore Places</h1>
      <p class="page-subtitle">Discover unique stays and experiences worldwide</p>
    </div>
    
  </div>

  <!-- Listings Grid -->
  <% if (listings && listings.length > 0) { %>
    <ul class="listings-grid">
      <% listings.forEach(listing => { %>
        <li>
          <a href="/listings/<%= listing._id %>" class="listing-card-link">
            <article class="listing-card">
              
              <!-- Image Container -->
              <div class="card-img-container">
                <% if (listing.image && listing.image.url) { %>
                  <img src="<%= listing.image%>" alt="<%= listing.title %>" class="card-img">
                <% } else { %>
                  <img src="https://images.unsplash.com/photo-1570129477492-45c003edd2be?q=80&w=600&auto=format&fit=crop" alt="Default listing image" class="card-img">
                <% } %>
              </div>

              <!-- Content Area -->
              <div class="card-body-content">
                <div>
                  <div style="display: flex; flex-direction: row; justify-content:space-between;">
                        <h2 class="listing-title" title="<%= listing.title %>"><%= listing.title %></h2> 
                  <p> <%= listing.user ? listing.user.username : 'Anonymous' %>  </p>
                  </div>
                  
                  <div class="listing-location">
                    <span>📍</span>
                    <span><%= listing.location %>, <%= listing.country %></span>
                  </div>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-2">
                  <div>
                    <% if (listing.price) { %>
                      <p class="listing-price">
                        &#8377; <%= listing.price.toLocaleString("en-IN") %>
                        <span class="listing-price-unit">/ night</span>
                      </p>
                    <% } %>
                  </div>
                  <span class="listing-action">Explore &rarr;</span>
                </div>
              </div>

            </article>
          </a>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <div class="empty-state">
      <h3 class="fw-bold mb-2">No listings found</h3>
      <p class="text-muted mb-4">Be the first to share a place with the community!</p>
      <a href="/listings/form" class="btn btn-brand-accent">
        Create a Listing
      </a>
    </div>
  <% } %>

</div>